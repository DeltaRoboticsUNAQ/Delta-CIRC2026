<?xml version="1.0"?>
<sdf version="1.7">
  <world name="ramp">
    <include>
      <uri>model://sun</uri>
    </include>

    <physics type="ode">
      <max_step_size>0.001</max_step_size>
      <real_time_update_rate>1000</real_time_update_rate>
    </physics>
    <gravity>0 0 -9.81</gravity>

    <model name="ground_plane">
      <static>true</static>
      <pose>0 0 0 0 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <plane>
              <normal>0 0 1</normal>
              <size>200 200</size>
            </plane>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Inclined ramp for pitch validation -->
    <model name="ramp">
      <static>true</static>
      <!-- Pose: x y z roll pitch yaw; pitch ~ 12deg -->
      <pose>4 0 0.62 0 0.21 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>4.0 4.0 0.20</size>
            </box>
          </geometry>
          <surface>
            <friction>
              <ode>
                <mu>1.2</mu>
                <mu2>1.2</mu2>
              </ode>
            </friction>
          </surface>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>4.0 4.0 0.20</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>

    <!-- Off-camber plate to force roll while moving -->
    <model name="offcamber">
      <static>true</static>
      <!-- roll ~ 10deg -->
      <pose>10 3 0.45 0.17 0 0</pose>
      <link name="link">
        <collision name="collision">
          <geometry>
            <box>
              <size>6.0 3.0 0.20</size>
            </box>
          </geometry>
        </collision>
        <visual name="visual">
          <geometry>
            <box>
              <size>6.0 3.0 0.20</size>
            </box>
          </geometry>
        </visual>
      </link>
    </model>
  </world>
</sdf>
