<?xml version="1.0" encoding="utf-8"?>
<robot name="arm_v3" xmlns:xacro="http://www.ros.org/wiki/xacro">

  <!-- BASE -->
  <link name="base_link">
    <inertial>
      <origin xyz="0 4.86187138273593E-18 0.0325" rpy="0 0 0" />
      <mass value="1.26223302335012" />
      <inertia
        ixx="0.00278940349899718"
        ixy="3.0463870585319E-37"
        ixz="-7.86275503544723E-36"
        iyy="0.00278940349899718"
        iyz="-1.44135783627155E-35"
        izz="0.00468998457738531" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://my_package/meshes/base_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.341176470588235 0.666666666666667 1 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://my_package/meshes/base_link.STL" />
      </geometry>
    </collision>
  </link>

  <!-- JOINT 1 -->
  <link name="bracket_link">
    <inertial>
      <origin xyz="3.1709E-05 -7.6273E-18 0.021174" rpy="0 0 0" />
      <mass value="0.1844" />
      <inertia
        ixx="0.00016429"
        ixy="-5.4545E-20"
        ixz="-1.128E-06"
        iyy="0.00012823"
        iyz="-3.9826E-20"
        izz="0.00017784" />
    </inertial>
    <visual>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://my_package/meshes/bracket_link.STL" />
      </geometry>
      <material name="">
        <color rgba="0.89804 0.91765 0.92941 1" />
      </material>
    </visual>
    <collision>
      <origin xyz="0 0 0" rpy="0 0 0" />
      <geometry>
        <mesh filename="package://my_package/meshes/bracket_link.STL" />
      </geometry>
    </collision>
  </link>

  <joint name="bracket_joint" type="revolute">
    <origin xyz="0 0 0.056" rpy="0 0 0" />
    <parent link="base_link" />
    <child link="bracket_link" />
    <axis xyz="0 0 1" />
    <limit lower="-1.5" upper="1.5" effort="10" velocity="1" />
    <dynamics damping="0.05" friction="0.1" />
  </joint>

  <!-- JOINT 2 -->
  <link name="humerus_link">
    <inertial>
      <origin xyz="0.04161 -0.027 0.21154" rpy="0 0 0" />
      <mass value="0.23656" />
      <inertia
        ixx="0.0024284"
        ixy="5.5605E-18"
        ixz="-0.0003857"
        iyy="0.0023823"
        iyz="-4.177E-19"
