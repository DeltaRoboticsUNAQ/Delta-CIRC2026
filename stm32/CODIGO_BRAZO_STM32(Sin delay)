// Direcciones RoboClaw
#define RC_ADDR_BASE   0x81
#define RC_ADDR_WRIST  0x80

// Timeout de seguridad para RoboClaw (7 segundos)
#define TIMEOUT_MS 7000

// ---- Puente ROS ----
#define RX_RING_SIZE     256
#define MAX_BASE_DUTY    127     // tope de velocidad base (0-127); tu teclado usaba 60
#define WRIST_MIX_RANGE  30     // ±rango sobre 64 para la muneca (igual que tu 94/34)

// CAMBIO: timeout de ACK de las RoboClaw (antes 100 ms — bloqueaba todo si no respondian)
#define RC_ACK_TIMEOUT_MS  20
/* USER CODE END PD */

/* Private variables ---------------------------------------------------------*/
/* USER CODE BEGIN PV */
// Variables para actuadores lineales (ADC/PWM)
uint16_t adc_val[2];

int pos1 = -1;
int pos2 = -1;

// ... tus variables anteriores ...
int current1 = 0;
int current2 = 0;

// ¡NUEVO MODO HÍBRIDO!
uint8_t mode1 = 0; // 0 = Posición, 1 = Velocidad
uint8_t mode2 = 0;
int vel1 = 0;
int vel2 = 0;

float kp = 4.5f;
float ki = 2.8f;

int e1 = 0;
int e2 = 0;

int duty1 = 0;
int duty2 = 0;

float integral1 = 0.0f;
float integral2 = 0.0f;

float integral_max = 300.0f;

// Variables para RoboClaw
RoboClaw_HandleTypeDef rcBase;
RoboClaw_HandleTypeDef rcWrist;

// CAMBIO: presencia de RoboClaws (detectadas UNA vez al arranque).
// Si no responden, se omite TODO su trafico para no bloquear el lazo
// de control de los actuadores (cada write_n espera ACK con reintentos).
bool rcOnline = false;

uint32_t lastCommandTime = 0;
bool motorsRunning = false;

// Variables para recordar comandos de RoboClaw
int lastBaseVelCmd = -999;
int lastPitchVelCmd = -999;
int lastRollVelCmd = -999;

// Variable para el "latido" de las RoboClaw
uint32_t rc_last_tx = 0;

// Scheduler por timers
volatile uint8_t flag_control = 0;

// ---- Puente ROS ----
volatile uint8_t  rxRing[RX_RING_SIZE];
volatile uint16_t rxHead = 0, rxTail = 0;

// Estimador de posición
int   baseVelCmd = 0, pitchVelCmd = 0, rollVelCmd = 0;
float basePosEst = 0.0f, pitchPosEst = 0.0f, rollPosEst = 0.0f;
uint8_t fbDiv = 0;
/* USER CODE END PV */

