{
  HAL_NVIC_SetPriority(TIM3_IRQn, 0, 0);
  HAL_NVIC_EnableIRQ(TIM3_IRQn);
}

/* USER CODE BEGIN 4 */
int uart2_write(int ch){
    while(!(USART2->SR & USART_SR_TXE)){}
    USART2->DR = (ch & 0xFF);
    return ch;
}

int __io_putchar(int ch){
    uart2_write(ch);
    return ch;
}

void forwardAct(int actuator, int duty){
    if(actuator == 1){
        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, duty);
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_6, GPIO_PIN_SET);
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_7, GPIO_PIN_RESET);
    }
    else if(actuator == 2){
        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, duty);
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11, GPIO_PIN_SET);
        HAL_GPIO_WritePin(GPIOB, GPIO_PIN_12, GPIO_PIN_RESET);
    }
}

void backwardAct(int actuator, int duty){
    if(actuator == 1){
        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, duty);
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_6, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_7, GPIO_PIN_SET);
    }
    else if(actuator == 2){
        __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, duty);
        HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11, GPIO_PIN_RESET);
        HAL_GPIO_WritePin(GPIOB, GPIO_PIN_12, GPIO_PIN_SET);
    }
}

void actStop(void){
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 0);
    __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, 0);
    HAL_GPIO_WritePin(GPIOB, GPIO_PIN_12, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_7, GPIO_PIN_RESET);
    HAL_GPIO_WritePin(GPIOA, GPIO_PIN_6, GPIO_PIN_RESET);
}

void stopAllRoboClaw(void)
{
    if(!rcOnline) return;   // CAMBIO: no bloquear si no hay RoboClaws
    RoboClaw_ForwardM1(&rcBase, RC_ADDR_BASE, 0);
    RoboClaw_ForwardM1(&rcWrist, RC_ADDR_WRIST, 0);
    RoboClaw_ForwardM2(&rcWrist, RC_ADDR_WRIST, 0);
}

void processCommand(uint8_t ch)
{
    char key = (char)ch;
    if(key == '1') { pos1 = 25; mode1 = 0; integral1 = 0.0f; printf(">> Act1 -> 25%%\r\n"); }
    else if(key == '2') { pos1 = 50; mode1 = 0; integral1 = 0.0f; printf(">> Act1 -> 50%%\r\n"); }
    else if(key == '3') { pos1 = 75; mode1 = 0; integral1 = 0.0f; printf(">> Act1 -> 75%%\r\n"); }
    else if(key == '4') { pos2 = 25; mode2 = 0; integral2 = 0.0f; printf(">> Act2 -> 25%%\r\n"); }
    else if(key == '5') { pos2 = 50; mode2 = 0; integral2 = 0.0f; printf(">> Act2 -> 50%%\r\n"); }
    else if(key == '6') { pos2 = 75; mode2 = 0; integral2 = 0.0f; printf(">> Act2 -> 75%%\r\n"); }
    else if(key == '0') { pos1 = 0; pos2 = 0; mode1 = 0; mode2 = 0; integral1 = 0.0f; integral2 = 0.0f; printf(">> Ambos -> 0%%\r\n"); }
    else if(key == '9') { pos1 = 100; pos2 = 100; mode1 = 0; mode2 = 0; integral1 = 0.0f; integral2 = 0.0f; printf(">> Ambos -> 100%%\r\n"); }
    else if (key == ' ') { stopAllRoboClaw(); motorsRunning = false; printf(">> RoboClaw DETENIDO\r\n"); }
    else if (key == 'X' || key == 'x') {
        stopAllRoboClaw();
        actStop();
        pos1 = current1;
        pos2 = current2;
        vel1 = 0; vel2 = 0;          // CAMBIO: corta tambien modo velocidad
        motorsRunning = false;
        printf(">> TODO DETENIDO\r\n");
    }
    else if (key == 'A' || key == 'a') { if(rcOnline){ RoboClaw_ForwardM1(&rcBase, RC_ADDR_BASE, 60); lastCommandTime = HAL_GetTick(); motorsRunning = true; printf(">> Base IZQ\r\n"); } }
    else if (key == 'D' || key == 'd') { if(rcOnline){ RoboClaw_BackwardM1(&rcBase, RC_ADDR_BASE, 60); lastCommandTime = HAL_GetTick(); motorsRunning = true; printf(">> Base DER\r\n"); } }
    else if (key == 'W' || key == 'w') { if(rcOnline){ RoboClaw_ForwardBackwardMixed(&rcWrist, RC_ADDR_WRIST, 94); lastCommandTime = HAL_GetTick(); motorsRunning = true; printf(">> Muneca SUBIR\r\n"); } }
    else if (key == 'S' || key == 's') { if(rcOnline){ RoboClaw_ForwardBackwardMixed(&rcWrist, RC_ADDR_WRIST, 34); lastCommandTime = HAL_GetTick(); motorsRunning = true; printf(">> Muneca BAJAR\r\n"); } }
    else if (key == 'Q' || key == 'q') { if(rcOnline){ RoboClaw_LeftRightMixed(&rcWrist, RC_ADDR_WRIST, 94); lastCommandTime = HAL_GetTick(); motorsRunning = true; printf(">> Muneca ROT IZQ\r\n"); } }
    else if (key == 'E' || key == 'e') { if(rcOnline){ RoboClaw_LeftRightMixed(&rcWrist, RC_ADDR_WRIST, 34); lastCommandTime = HAL_GetTick(); motorsRunning = true; printf(">> Muneca ROT DER\r\n"); } }
}

void setBaseVel(int v){
    if(!rcOnline) return;   // CAMBIO
    if(v > 100) v = 100; if(v < -100) v = -100;
    int mag = (abs(v) * MAX_BASE_DUTY) / 100;
    if(v > 0)      RoboClaw_ForwardM1(&rcBase, RC_ADDR_BASE, mag);
    else if(v < 0) RoboClaw_BackwardM1(&rcBase, RC_ADDR_BASE, mag);
    else           RoboClaw_ForwardM1(&rcBase, RC_ADDR_BASE, 0);
    if(v != 0){ lastCommandTime = HAL_GetTick(); motorsRunning = true; }
}

void setWristPitchVel(int v){
    if(!rcOnline) return;   // CAMBIO
    if(v > 100) v = 100; if(v < -100) v = -100;
    RoboClaw_ForwardBackwardMixed(&rcWrist, RC_ADDR_WRIST, 64 + (v * WRIST_MIX_RANGE) / 100);
    if(v != 0){ lastCommandTime = HAL_GetTick(); motorsRunning = true; }
}

void setWristRollVel(int v){
    if(!rcOnline) return;   // CAMBIO
    if(v > 100) v = 100; if(v < -100) v = -100;
    RoboClaw_LeftRightMixed(&rcWrist, RC_ADDR_WRIST, 64 + (v * WRIST_MIX_RANGE) / 100);
    if(v != 0){ lastCommandTime = HAL_GetTick(); motorsRunning = true; }
}

// BÚSCALO EN TU USER CODE BEGIN 4
void parseRosCommand(char *line){
    // Regresamos al código invencible
    if (strncmp(line, "STOP", 4) == 0){
        stopAllRoboClaw(); actStop();
        pos1 = current1; pos2 = current2;
        vel1 = 0; vel2 = 0;          // CAMBIO: corta tambien modo velocidad
        baseVelCmd = pitchVelCmd = rollVelCmd = 0;
        lastBaseVelCmd = lastPitchVelCmd = lastRollVelCmd = 0;
        motorsRunning = false;
        return;
    }

    if      (strncmp(line, "A1,", 3) == 0){ mode1 = 0; int p=atoi(line+3); if(p<0)p=0; if(p>100)p=100; pos1=p; }
    else if (strncmp(line, "A2,", 3) == 0){ mode2 = 0; int p=atoi(line+3); if(p<0)p=0; if(p>100)p=100; pos2=p; }

    else if (strncmp(line, "V1,", 3) == 0){ mode1 = 1; vel1 = atoi(line+3); lastCommandTime = HAL_GetTick(); motorsRunning = true; }
    else if (strncmp(line, "V2,", 3) == 0){ mode2 = 1; vel2 = atoi(line+3); lastCommandTime = HAL_GetTick(); motorsRunning = true; }

    else if (strncmp(line, "BV,", 3) == 0){ baseVelCmd = atoi(line+3); lastCommandTime = HAL_GetTick(); motorsRunning = true; }
    else if (strncmp(line, "WP,", 3) == 0){ pitchVelCmd = atoi(line+3); lastCommandTime = HAL_GetTick(); motorsRunning = true; }
    else if (strncmp(line, "WR,", 3) == 0){ rollVelCmd = atoi(line+3); lastCommandTime = HAL_GetTick(); motorsRunning = true; }
}

void pollUartCommands(void){
    static char lineBuf[64];
    static uint8_t lineLen = 0, inFrame = 0;
    while(rxTail != rxHead){
        uint8_t ch = rxRing[rxTail];
        rxTail = (uint16_t)((rxTail + 1) % RX_RING_SIZE);
        if(!inFrame){
            if(ch == '#'){ inFrame = 1; lineLen = 0; }
            else { processCommand(ch); }
        } else {
            if(ch == '\n' || ch == '\r' || lineLen >= sizeof(lineBuf)-1){
                lineBuf[lineLen] = '\0';
                parseRosCommand(lineBuf);
                inFrame = 0; lineLen = 0;
            } else {
                lineBuf[lineLen++] = ch;
            }
        }
    }
}

void USART2_IRQHandler(void)
{
    uint32_t sr = USART2->SR;
    if(sr & USART_SR_RXNE)
    {
        uint8_t ch = (uint8_t)(USART2->DR & 0xFF);
        uint16_t next = (uint16_t)((rxHead + 1) % RX_RING_SIZE);
        if(next != rxTail){ rxRing[rxHead] = ch; rxHead = next; }
    }
    else if(sr & USART_SR_ORE) { (void)USART2->DR; }
}

