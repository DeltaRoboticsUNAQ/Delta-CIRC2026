int main(void)
{
  HAL_Init();
  SystemClock_Config();
  MX_GPIO_Init();
  MX_DMA_Init();
  MX_USART2_UART_Init();
  MX_ADC1_Init();
  MX_TIM1_Init();
  MX_TIM3_Init();
  MX_USART1_UART_Init();
  MX_NVIC_Init();

  /* USER CODE BEGIN 2 */
  HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_1);
  HAL_TIM_PWM_Start(&htim1, TIM_CHANNEL_2);
  HAL_ADC_Start_DMA(&hadc1, (uint32_t*)&adc_val, 2);

  HAL_GPIO_WritePin(GPIOC, GPIO_PIN_2, GPIO_PIN_SET);
  HAL_GPIO_WritePin(GPIOC, GPIO_PIN_3, GPIO_PIN_SET);

  HAL_TIM_Base_Start_IT(&htim3);

  // CAMBIO: timeout corto (20 ms). Con 100 ms + 2 reintentos, cada comando
  // a una RoboClaw ausente bloqueaba ~300 ms.
  RoboClaw_Init(&rcBase, &huart1, RC_ACK_TIMEOUT_MS);
  RoboClaw_Init(&rcWrist, &huart1, RC_ACK_TIMEOUT_MS);

  actStop();

  // CAMBIO v2: deteccion de RoboClaws SOLO con escritura. La version anterior
  // usaba ReadMainBatteryVoltage, cuyo flush() interno es un while que lee
  // mientras lleguen bytes: con PA10 (RX) flotando (RoboClaws desconectadas,
  // sin pull-up) el UART puede "recibir" ruido sin parar y el micro se cuelga
  // ANTES del banner. write_n no hace flush y esta acotado a 3 intentos x 20 ms:
  // manda un stop (velocidad 0) y solo marca online si llega el ACK 0xFF.
  // (Si conectas las RoboClaws despues, resetea la Nucleo con ellas encendidas.)
  rcOnline = RoboClaw_ForwardM1(&rcBase, RC_ADDR_BASE, 0);
  if (!rcOnline)
      rcOnline = RoboClaw_ForwardM1(&rcWrist, RC_ADDR_WRIST, 0);

  stopAllRoboClaw();   // internamente ya esta guardado con rcOnline

  __HAL_UART_ENABLE_IT(&huart2, UART_IT_RXNE);
  HAL_NVIC_SetPriority(USART2_IRQn, 5, 0);
  HAL_NVIC_EnableIRQ(USART2_IRQn);

  printf("\r\n========================================\r\n");
  printf("		Control Base STM32\r\n");
  printf("========================================\r\n");
  printf("RoboClaw: %s\r\n", rcOnline ? "ONLINE" : "NO DETECTADA (trafico RoboClaw omitido)");
  printf("Controles Actuadores Lineales:\r\n");
  printf("  1/2/3 - Actuador 1: 25%%/50%%/75%%\r\n");
  printf("  4/5/6 - Actuador 2: 25%%/50%%/75%%\r\n");
  printf("  0 - Ambos a 0%%\r\n");
  printf("  9 - Ambos a 100%%\r\n");
  printf("----------------------------------------\r\n");
  printf("Controles RoboClaw:\r\n");
  printf("  A/D - Base izquierda/derecha\r\n");
  printf("  W/S - Muneca subir/bajar\r\n");
  printf("  Q/E - Muneca rotar izq/der\r\n");
  printf("  ESPACIO - Detener RoboClaw\r\n");
  printf("  X - Detener TODO\r\n");
  printf("----------------------------------------\r\n");
  printf("Comandos ROS (prefijo '#'): #A1,p #A2,p #BV,v #WP,v #WR,v #STOP\r\n");
  printf("Auto-stop RoboClaw: 7 segundos\r\n\r\n");
  /* USER CODE END 2 */

  while (1)
  {
      // Drenar buffer todo el tiempo
      pollUartCommands();

      if(flag_control==1)
      {
          flag_control = 0;

          // CAMBIO: latido visual. LD2 (LED verde, PA5) parpadea a ~1 Hz
          // cuando el lazo de control corre => "el micro esta vivo" aunque
          // el serial no funcione.
          {
              static uint8_t ledDiv = 0;
              if (++ledDiv >= 25) { ledDiv = 0; HAL_GPIO_TogglePin(LD2_GPIO_Port, LD2_Pin); }
          }

          // --- LATIDO ROBOCLAW (HEARTBEAT) ---
          if (baseVelCmd != lastBaseVelCmd ||
              pitchVelCmd != lastPitchVelCmd ||
              rollVelCmd != lastRollVelCmd ||
              (HAL_GetTick() - rc_last_tx > 100))
          {
              // CAMBIO: solo se transmite si las RoboClaw existen. La contabilidad
              // (last*) se actualiza igual para no re-disparar la condicion.
              if (rcOnline)
              {
                  setBaseVel(baseVelCmd);
                  setWristPitchVel(pitchVelCmd);
                  setWristRollVel(rollVelCmd);
              }

              lastBaseVelCmd = baseVelCmd;
              lastPitchVelCmd = pitchVelCmd;
              lastRollVelCmd = rollVelCmd;
              rc_last_tx = HAL_GetTick();
          }

          current1 = (adc_val[0] * 100) / 4095;
          current2 = (adc_val[1] * 100) / 4095;

          // --- SEGURO ANTI-SUSTOS EN EL ARRANQUE ---
          if (pos1 == -1) pos1 = current1;
          if (pos2 == -1) pos2 = current2;

          e1 = pos1 - current1;
          e2 = pos2 - current2;

          // ACTUADOR 1
          if (mode1 == 0) {
              if(abs(e1) < 2){
                  integral1 = 0.0f;
                  __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 0);
                  HAL_GPIO_WritePin(GPIOA, GPIO_PIN_6, GPIO_PIN_RESET);
                  HAL_GPIO_WritePin(GPIOA, GPIO_PIN_7, GPIO_PIN_RESET);
              }else{
                  integral1 += e1;
                  if(integral1 > integral_max) integral1 = integral_max;
                  if(integral1 < -integral_max) integral1 = -integral_max;
                  duty1 = (int)((kp * abs(e1)) + (ki * abs(integral1)));

                  // LIMITADOR ELÉCTRICO: Evita que el voltaje se caiga
                  if(duty1 > 700) duty1 = 700;

                  if(e1 > 0) forwardAct(1, duty1);
                  else backwardAct(1, duty1);
              }
          } else {
              integral1 = 0.0f; pos1 = current1; // Sincroniza en silencio
              int v_pwm = vel1 * 10;
              if (v_pwm > 999) v_pwm = 999; if (v_pwm < -999) v_pwm = -999;
              if (v_pwm > 0) forwardAct(1, v_pwm);
              else if (v_pwm < 0) backwardAct(1, -v_pwm);
              else {
                  __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_1, 0);
                  HAL_GPIO_WritePin(GPIOA, GPIO_PIN_6, GPIO_PIN_RESET);
                  HAL_GPIO_WritePin(GPIOA, GPIO_PIN_7, GPIO_PIN_RESET);
              }
          }

          // ACTUADOR 2
          if (mode2 == 0) {
              if(abs(e2) < 2){
                  integral2 = 0.0f;
                  __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, 0);
                  HAL_GPIO_WritePin(GPIOB, GPIO_PIN_12, GPIO_PIN_RESET);
                  HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11, GPIO_PIN_RESET);
              }else{
                  integral2 += e2;
                  if(integral2 > integral_max) integral2 = integral_max;
                  if(integral2 < -integral_max) integral2 = -integral_max;
                  duty2 = (int)((kp * abs(e2)) + (ki * abs(integral2)));

                  // LIMITADOR ELÉCTRICO: Evita que el voltaje se caiga
                  if(duty2 > 700) duty2 = 700;

                  if(e2 > 0) forwardAct(2, duty2);
                  else backwardAct(2, duty2);
              }
          } else {
              integral2 = 0.0f; pos2 = current2;
              int v_pwm2 = vel2 * 10;
              if (v_pwm2 > 999) v_pwm2 = 999; if (v_pwm2 < -999) v_pwm2 = -999;
              if (v_pwm2 > 0) forwardAct(2, v_pwm2);
              else if (v_pwm2 < 0) backwardAct(2, -v_pwm2);
              else {
                  __HAL_TIM_SET_COMPARE(&htim1, TIM_CHANNEL_2, 0);
                  HAL_GPIO_WritePin(GPIOB, GPIO_PIN_12, GPIO_PIN_RESET);
                  HAL_GPIO_WritePin(GPIOA, GPIO_PIN_11, GPIO_PIN_RESET);
              }
          }
          //Timeout RoboClaw
          if (motorsRunning && (HAL_GetTick() - lastCommandTime > TIMEOUT_MS))
          {
              stopAllRoboClaw();
              motorsRunning = false;
              baseVelCmd = pitchVelCmd = rollVelCmd = 0;
              lastBaseVelCmd = lastPitchVelCmd = lastRollVelCmd = 0;
              // CAMBIO: tambien corta el modo velocidad de los actuadores.
              // Antes vel1/vel2 quedaban vivos y los actuadores seguian
              // moviendose para siempre tras el timeout.
              vel1 = 0;
              vel2 = 0;
              printf(">> AUTO-STOP (timeout 7s)\r\n");
          }

          // Realimentacion a ROS
          if(++fbDiv >= 2){
              fbDiv = 0;
              basePosEst  += (float)baseVelCmd  * 0.02f;
              pitchPosEst += (float)pitchVelCmd * 0.02f;
              rollPosEst  += (float)rollVelCmd  * 0.02f;
              printf("J,%d,%d,%d,%d,%d\r\n",
                     current1, current2,
                     (int)basePosEst, (int)pitchPosEst, (int)rollPosEst);
          }
      }
  }
}

void SystemClock_Config(void)
{
  RCC_OscInitTypeDef RCC_OscInitStruct = {0};
  RCC_ClkInitTypeDef RCC_ClkInitStruct = {0};

  __HAL_RCC_PWR_CLK_ENABLE();
  __HAL_PWR_VOLTAGESCALING_CONFIG(PWR_REGULATOR_VOLTAGE_SCALE1);

  RCC_OscInitStruct.OscillatorType = RCC_OSCILLATORTYPE_HSE;
  // CAMBIO CRITICO: la Nucleo-F446RE no trae cristal (X3 sin soldar); los 8 MHz
  // del HSE vienen del MCO del ST-LINK y eso exige modo BYPASS. Con RCC_HSE_ON
  // el HSE nunca arranca -> HAL_RCC_OscConfig falla -> Error_Handler -> placa
  // muda (sin serial y sin movimiento).
  // OJO: SystemClock_Config esta FUERA de los bloques USER CODE. Cambia esto
  // tambien en el .ioc (System Core -> RCC -> HSE -> "BYPASS Clock Source")
  // o CubeMX lo revertira en la proxima regeneracion.
  RCC_OscInitStruct.HSEState = RCC_HSE_BYPASS;
  RCC_OscInitStruct.PLL.PLLState = RCC_PLL_ON;
  RCC_OscInitStruct.PLL.PLLSource = RCC_PLLSOURCE_HSE;
  RCC_OscInitStruct.PLL.PLLM = 4;
  RCC_OscInitStruct.PLL.PLLN = 180;
  RCC_OscInitStruct.PLL.PLLP = RCC_PLLP_DIV2;
  RCC_OscInitStruct.PLL.PLLQ = 2;
  RCC_OscInitStruct.PLL.PLLR = 2;
  if (HAL_RCC_OscConfig(&RCC_OscInitStruct) != HAL_OK) { Error_Handler(); }

  if (HAL_PWREx_EnableOverDrive() != HAL_OK) { Error_Handler(); }

  RCC_ClkInitStruct.ClockType = RCC_CLOCKTYPE_HCLK|RCC_CLOCKTYPE_SYSCLK
                              |RCC_CLOCKTYPE_PCLK1|RCC_CLOCKTYPE_PCLK2;
  RCC_ClkInitStruct.SYSCLKSource = RCC_SYSCLKSOURCE_PLLCLK;
  RCC_ClkInitStruct.AHBCLKDivider = RCC_SYSCLK_DIV1;
  RCC_ClkInitStruct.APB1CLKDivider = RCC_HCLK_DIV4;
  RCC_ClkInitStruct.APB2CLKDivider = RCC_HCLK_DIV2;

  if (HAL_RCC_ClockConfig(&RCC_ClkInitStruct, FLASH_LATENCY_5) != HAL_OK) { Error_Handler(); }
}

